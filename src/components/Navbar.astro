---
const navLinks = [
  { href: '/',              label: 'Inicio' },
  { href: '/sobre-mi',      label: 'Sobre mí' },
  { href: '/libros',        label: 'Libros' },
  { href: '/conferencias',  label: 'Conferencias' },
  { href: '/activismo',     label: 'Activismo' },
  { href: '/publicaciones', label: 'Publicaciones' },
  { href: '/multimedia',    label: 'Multimedia' },
  { href: '/premios',       label: 'Premios' },
  { href: '/contacto',      label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-obsidian-900/95 backdrop-blur-sm border-b border-crema-300 dark:border-obsidian-700 transition-colors duration-200">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Nombre como logo -->
      <a
        href="/"
        class="font-serif text-lg font-semibold text-obsidian-900 dark:text-crema-200 hover:text-ocre-500 dark:hover:text-ocre-400 transition-colors"
      >
        Melibea Obono
      </a>

      <!-- Navegación desktop (oculta en móvil/tablet) -->
      <div class="hidden lg:flex items-center gap-5">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-sans transition-colors whitespace-nowrap',
              currentPath === link.href
                ? 'text-ocre-500 dark:text-ocre-400 font-medium'
                : 'text-gray-600 dark:text-crema-300 hover:text-ocre-500 dark:hover:text-ocre-400',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Controles: toggle tema + hamburguesa -->
      <div class="flex items-center gap-2">

        <!-- Toggle claro/oscuro -->
        <button
          id="theme-toggle"
          aria-label="Cambiar modo claro/oscuro"
          class="p-2 rounded-full text-gray-500 dark:text-crema-300 hover:bg-crema-100 dark:hover:bg-obsidian-800 transition-colors"
        >
          <!-- Sol: visible en modo oscuro (para volver al claro) -->
          <svg
            id="icon-sun"
            class="h-5 w-5 hidden dark:block"
            xmlns="http://www.w3.org/2000/svg"
            fill="none" viewBox="0 0 24 24" stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z" />
          </svg>
          <!-- Luna: visible en modo claro (para activar oscuro) -->
          <svg
            id="icon-moon"
            class="h-5 w-5 block dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            fill="none" viewBox="0 0 24 24" stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Hamburguesa (solo en móvil/tablet) -->
        <button
          id="menu-toggle"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden p-2 rounded-md text-gray-500 dark:text-crema-300 hover:bg-crema-100 dark:hover:bg-obsidian-800 transition-colors"
        >
          <svg id="icon-menu-open" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-menu-close" class="h-6 w-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú móvil desplegable -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden py-3 border-t border-crema-300 dark:border-obsidian-700"
    >
      <div class="flex flex-col gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-md text-sm font-sans transition-colors',
              currentPath === link.href
                ? 'bg-ocre-500/10 text-ocre-600 dark:text-ocre-400 font-medium'
                : 'text-gray-600 dark:text-crema-300 hover:bg-crema-100 dark:hover:bg-obsidian-800',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // === DARK MODE TOGGLE ===
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // === HAMBURGUESA (MENÚ MÓVIL) ===
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen   = document.getElementById('icon-menu-open');
  const iconClose  = document.getElementById('icon-menu-close');

  menuToggle?.addEventListener('click', () => {
    // toggle('hidden') devuelve true si añadió la clase (ocultó), false si la quitó (mostró)
    const nowHidden = mobileMenu?.classList.toggle('hidden') ?? true;
    menuToggle.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
    iconOpen?.classList.toggle('hidden', !nowHidden);
    iconClose?.classList.toggle('hidden', nowHidden);
  });
</script>
