---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const libro = await getEntry('libros', 'la-hija-de-las-mitangan');
const citas = libro?.data.pressQuotes ?? [];
---

<BaseLayout
  title="Trifonia Melibea Obono — Artivista, Escritora, Académica"
  description="Web oficial de Trifonia Melibea Obono: escritora guineana, becaria Humboldt y activista de derechos humanos. Autora de ocho libros estudiados en universidades de todo el mundo."
>

  <!-- ═══════════════════════════════════════════
       1. HERO — nombre gigante + foto
  ════════════════════════════════════════════ -->
  <section class="min-h-screen grid grid-cols-1 lg:grid-cols-[55fr_45fr] bg-obsidian-900 overflow-hidden">

    <!-- Columna texto -->
    <div class="relative z-10 flex flex-col justify-end lg:justify-center
                px-8 sm:px-12 md:px-16 lg:px-20 xl:px-28
                pb-16 pt-8 lg:py-24 bg-obsidian-900">

      <p class="font-sans text-xs uppercase tracking-[0.25em] text-ocre-500 mb-8 lg:mb-10">
        Guinea Ecuatorial · Duisburg-Essen
      </p>

      <h1 class="font-serif leading-[0.85] -tracking-[0.02em] mb-8 lg:mb-10">
        <span class="block text-crema-200"
              style="font-size: clamp(2.8rem, 8vw, 7rem)">TRIFONIA</span>
        <span class="block text-ocre-500"
              style="font-size: clamp(3.5rem, 10.5vw, 9.5rem)">MELIBEA</span>
        <span class="block text-crema-200"
              style="font-size: clamp(2.8rem, 8vw, 7rem)">OBONO</span>
      </h1>

      <div class="w-14 h-[3px] bg-ocre-500 mb-6 lg:mb-8"></div>

      <p class="font-sans text-xs sm:text-sm uppercase tracking-[0.2em] text-crema-300/70 mb-10 lg:mb-12">
        Artivista &nbsp;·&nbsp; Escritora &nbsp;·&nbsp; Académica &nbsp;·&nbsp; Activista de DDHH
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/libros"
           class="group inline-flex items-center gap-3 font-sans text-sm text-crema-200 border border-crema-200/20 hover:border-ocre-500 hover:text-ocre-500 px-6 py-3 transition-colors">
          Descubrir su obra
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a href="/sobre-mi"
           class="inline-flex items-center font-sans text-sm text-crema-300/50 hover:text-crema-200 px-6 py-3 transition-colors">
          Sobre mí
        </a>
      </div>
    </div>

    <!-- Columna foto -->
    <div class="relative min-h-[65vw] lg:min-h-0 order-first lg:order-last">
      <img
        src="/images/melibea/foto-hero.jpg"
        alt="Trifonia Melibea Obono"
        class="absolute inset-0 w-full h-full object-cover object-top lg:object-[center_20%]"
        loading="eager"
      />
      <!-- Fusión izquierda en desktop -->
      <div class="absolute inset-y-0 left-0 w-2/5 bg-gradient-to-r from-obsidian-900 to-transparent hidden lg:block"></div>
      <!-- Fusión inferior en móvil -->
      <div class="absolute bottom-0 left-0 right-0 h-2/5 bg-gradient-to-t from-obsidian-900 to-transparent lg:hidden"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. FRASE DE IMPACTO — banda ámbar
  ════════════════════════════════════════════ -->
  <section class="bg-ocre-500 py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-8 sm:px-12 md:px-16">
      <blockquote class="border-l-[5px] border-obsidian-900 pl-8 md:pl-12">
        <p class="font-serif italic leading-snug text-obsidian-900"
           style="font-size: clamp(1.6rem, 4vw, 3rem)">
          «En el movimiento de la negritud<br class="hidden sm:block" />
          no está autorizada la disidencia.»
        </p>
        <footer class="font-sans text-xs uppercase tracking-[0.2em] text-obsidian-900/50 mt-5">
          — Trifonia Melibea Obono · ElDiario.es
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       3. ÚLTIMO LIBRO — La hija de las mitangan
  ════════════════════════════════════════════ -->
  <section class="bg-obsidian-900 py-24 md:py-32 px-8 sm:px-12 md:px-16">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-16 lg:gap-24 items-start">

      <!-- Citas y metadatos -->
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracota-500 mb-4">Último libro</p>
        <h2 class="font-serif text-crema-200 leading-tight mb-3"
            style="font-size: clamp(2rem, 5vw, 3.5rem)">
          La hija de las mitangan
        </h2>
        <p class="font-sans text-sm text-crema-400/60 mb-2">
          2023 · Wanafrica Ediciones
        </p>
        <span class="inline-block font-sans text-xs uppercase tracking-widest text-terracota-400 border border-terracota-500/40 px-3 py-1 mb-12">
          Premio Periplo 2023
        </span>

        <div class="space-y-8">
          {citas.map((cita) => (
            <blockquote class="border-l-2 border-ocre-500 pl-5">
              <p class="font-serif text-lg sm:text-xl italic text-crema-200 leading-snug mb-3">
                «{cita.quote}»
              </p>
              <footer class="font-sans text-xs text-ocre-500">
                — {cita.author}, <span class="text-crema-400/50">{cita.source}</span>
              </footer>
            </blockquote>
          ))}
        </div>

        <a href="/libros"
           class="group inline-flex items-center gap-2 mt-12 font-sans text-sm text-ocre-500 hover:text-ocre-400 border-b border-ocre-500/40 hover:border-ocre-400 pb-0.5 transition-colors">
          Ver todos los libros
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <!-- Portada placeholder (arte africano con la paleta) -->
      <div class="relative max-w-xs mx-auto lg:max-w-none">
        <div class="aspect-[3/4] relative overflow-hidden"
             style="background: linear-gradient(160deg, #dc2626 0%, #7c3aed 50%, #14532d 100%)">
          <!-- Detalle geométrico abstracto -->
          <div class="absolute inset-0 opacity-30"
               style="background: radial-gradient(circle at 75% 25%, #f5ede0 0%, transparent 45%), radial-gradient(circle at 20% 75%, #c8922a 0%, transparent 40%)"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6"
               style="background: linear-gradient(to top, rgba(26,16,8,0.95) 0%, transparent 100%)">
            <p class="font-serif text-crema-200 text-xl leading-tight">La hija de las mitangan</p>
            <p class="font-sans text-crema-400/60 text-xs mt-1">Wanafrica Ediciones · 2023</p>
          </div>
        </div>
        <!-- Sombra decorativa ámbar detrás -->
        <div class="absolute -bottom-4 -right-4 w-full h-full bg-ocre-500/15 -z-10 hidden lg:block"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       4. ACTIVISMO — verde selva
  ════════════════════════════════════════════ -->
  <section class="py-20 md:py-28 px-8 sm:px-12 md:px-16" style="background-color: #166534">
    <div class="max-w-4xl mx-auto">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-ocre-300 mb-8">Activismo</p>
      <p class="font-serif text-crema-200 leading-snug mb-10"
         style="font-size: clamp(1.6rem, 4vw, 2.8rem)">
        Durante ocho años coordinó <em class="not-italic text-ocre-300">Somos Parte del Mundo</em>
        en Guinea Ecuatorial —país dictatorial—.<br />
        <span class="text-terracota-300">Fue encarcelada en agosto de 2023.</span>
      </p>
      <p class="font-sans text-sm text-crema-200/50 mb-8 leading-relaxed max-w-xl">
        Sus seis informes de derechos humanos motivaron el escrutinio de la ONU,
        la Unión Africana y la Unión Europea.
      </p>
      <a href="/activismo"
         class="group inline-flex items-center gap-2 font-sans text-sm text-crema-200/70 hover:text-crema-200 border-b border-crema-200/20 hover:border-crema-200/60 pb-0.5 transition-colors">
        Ver informes de derechos humanos
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. CIFRAS — presencia internacional
  ════════════════════════════════════════════ -->
  <section class="bg-obsidian-900 py-16 md:py-20 px-8 sm:px-12 md:px-16 border-t border-obsidian-700">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 text-center mb-12">
        {[
          { n: '8', label: 'Libros publicados' },
          { n: '8+', label: 'Conferencias internacionales' },
          { n: '6', label: 'Informes de DDHH' },
          { n: '4', label: 'Premios internacionales' },
        ].map(({ n, label }) => (
          <div>
            <p class="font-serif text-ocre-500 leading-none mb-2"
               style="font-size: clamp(3rem, 7vw, 5rem)">{n}</p>
            <p class="font-sans text-xs uppercase tracking-widest text-crema-400/50">{label}</p>
          </div>
        ))}
      </div>

      <!-- Ciudades donde ha conferenciado -->
      <p class="font-sans text-xs text-center text-crema-400/30 tracking-widest uppercase">
        Viena &nbsp;·&nbsp; Hamburgo &nbsp;·&nbsp; Lyon &nbsp;·&nbsp; Berlín &nbsp;·&nbsp;
        Barcelona &nbsp;·&nbsp; Alcalá de Henares &nbsp;·&nbsp; Wuppertal &nbsp;·&nbsp; Salamanca
      </p>
    </div>
  </section>

</BaseLayout>
