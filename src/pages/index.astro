---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const libro = await getEntry('libros', 'la-hija-de-las-mitangan');
const citas = libro?.data.pressQuotes ?? [];
---

<BaseLayout
  title="Trifonia Melibea Obono — Artivista, Escritora, Académica"
  description="Web oficial de Trifonia Melibea Obono: escritora guineana, becaria Humboldt y activista de derechos humanos. Autora de ocho libros estudiados en universidades de todo el mundo."
>

  <!-- ═══ 1. HERO ═══
       Claro: fondo blanco + nombre negro + foto
       Oscuro: fondo negro + nombre crema + foto con overlay
  ══════════════════ -->
  <section class="min-h-screen grid grid-cols-1 lg:grid-cols-[55fr_45fr] bg-white dark:bg-obsidian-900 transition-colors duration-300 overflow-hidden">

    <!-- Texto -->
    <div class="relative z-10 flex flex-col justify-end lg:justify-center
                px-8 sm:px-12 md:px-16 lg:px-20 xl:px-28
                pb-16 pt-8 lg:py-24 bg-white dark:bg-obsidian-900 transition-colors duration-300">

      <p class="font-sans text-xs uppercase tracking-[0.25em] text-ocre-500 mb-8 lg:mb-10">
        Guinea Ecuatorial · Duisburg-Essen
      </p>

      <!-- Nombre: negro en claro, crema en oscuro. MELIBEA siempre en violeta. -->
      <h1 class="font-serif leading-[0.85] -tracking-[0.02em] mb-8 lg:mb-10">
        <span class="block text-gray-900 dark:text-crema-200 transition-colors duration-300"
              style="font-size: clamp(2.8rem, 8vw, 7rem)">TRIFONIA</span>
        <span class="block text-ocre-500"
              style="font-size: clamp(3.5rem, 10.5vw, 9.5rem)">MELIBEA</span>
        <span class="block text-gray-900 dark:text-crema-200 transition-colors duration-300"
              style="font-size: clamp(2.8rem, 8vw, 7rem)">OBONO</span>
      </h1>

      <div class="w-14 h-[3px] bg-ocre-500 mb-6 lg:mb-8"></div>

      <p class="font-sans text-xs sm:text-sm uppercase tracking-[0.2em] text-gray-500 dark:text-crema-300/70 mb-10 lg:mb-12 transition-colors duration-300">
        Artivista &nbsp;·&nbsp; Escritora &nbsp;·&nbsp; Académica &nbsp;·&nbsp; Activista de DDHH
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/libros"
           class="group inline-flex items-center gap-3 font-sans text-sm
                  border border-gray-900 dark:border-crema-200/20
                  text-gray-900 dark:text-crema-200
                  hover:border-ocre-500 hover:text-ocre-500
                  dark:hover:border-ocre-500 dark:hover:text-ocre-500
                  px-6 py-3 transition-colors duration-200">
          Ver libros
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a href="/investigacion"
           class="inline-flex items-center font-sans text-sm px-6 py-3
                  text-gray-400 dark:text-crema-300/50
                  hover:text-ocre-500 dark:hover:text-ocre-400 transition-colors">
          Perfil académico
        </a>
      </div>
    </div>

    <!-- Foto -->
    <div class="relative min-h-[65vw] lg:min-h-0 order-first lg:order-last">
      <img
        src="/images/melibea/foto-hero.jpg"
        alt="Trifonia Melibea Obono"
        class="absolute inset-0 w-full h-full object-cover object-top lg:object-[center_20%]"
        loading="eager"
      />
      <!-- Gradiente izquierdo en desktop — blanco en claro, negro en oscuro -->
      <div class="absolute inset-y-0 left-0 w-2/5 bg-gradient-to-r from-white to-transparent hidden lg:block dark:hidden transition-colors"></div>
      <div class="absolute inset-y-0 left-0 w-2/5 bg-gradient-to-r from-obsidian-900 to-transparent hidden dark:lg:block transition-colors"></div>
      <!-- Gradiente inferior en móvil -->
      <div class="absolute bottom-0 left-0 right-0 h-2/5 bg-gradient-to-t from-white to-transparent lg:hidden dark:hidden"></div>
      <div class="absolute bottom-0 left-0 right-0 h-2/5 bg-gradient-to-t from-obsidian-900 to-transparent lg:hidden hidden dark:block"></div>
    </div>
  </section>

  <!-- ═══ 2. FRASE DE IMPACTO — banda violeta (igual en ambos modos) ═══ -->
  <section class="bg-ocre-500 py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-8 sm:px-12 md:px-16">
      <blockquote class="border-l-[5px] border-white/40 pl-8 md:pl-12">
        <p class="font-serif italic leading-snug text-white"
           style="font-size: clamp(1.6rem, 4vw, 3rem)">
          «En el movimiento de la negritud<br class="hidden sm:block" />
          no está autorizada la disidencia.»
        </p>
        <footer class="font-sans text-xs uppercase tracking-[0.2em] text-white/60 mt-5">
          — Trifonia Melibea Obono · ElDiario.es
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ═══ 3. ÚLTIMO LIBRO ═══
       Claro: fondo gris muy claro
       Oscuro: fondo negro
  ══════════════════ -->
  <section class="bg-gray-50 dark:bg-obsidian-900 py-24 md:py-32 px-8 sm:px-12 md:px-16 transition-colors duration-300 border-t border-gray-100 dark:border-obsidian-700">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-16 lg:gap-24 items-start">

      <div>
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracota-500 mb-4">Último libro</p>
        <h2 class="font-serif text-gray-900 dark:text-crema-200 leading-tight mb-3 transition-colors"
            style="font-size: clamp(2rem, 5vw, 3.5rem)">
          La hija de las mitangan
        </h2>
        <p class="font-sans text-sm text-gray-400 dark:text-crema-400/60 mb-2">
          2023 · Wanafrica Ediciones
        </p>
        <span class="inline-block font-sans text-xs uppercase tracking-widest text-terracota-500 border border-terracota-500/40 px-3 py-1 mb-12">
          Premio Periplo 2023
        </span>

        <div class="space-y-8">
          {citas.map((cita) => (
            <blockquote class="border-l-2 border-ocre-500 pl-5">
              <p class="font-serif text-lg sm:text-xl italic text-gray-800 dark:text-crema-200 leading-snug mb-3 transition-colors">
                «{cita.quote}»
              </p>
              <footer class="font-sans text-xs text-ocre-500">
                — {cita.author}, <span class="text-gray-400 dark:text-crema-400/50">{cita.source}</span>
              </footer>
            </blockquote>
          ))}
        </div>

        <a href="/libros"
           class="group inline-flex items-center gap-2 mt-12 font-sans text-sm text-ocre-500 hover:text-ocre-600 border-b border-ocre-500/40 hover:border-ocre-500 pb-0.5 transition-colors">
          Ver todos los libros
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <!-- Portada placeholder con gradiente violeta→rosa (Wanafrica evocado) -->
      <div class="relative max-w-xs mx-auto lg:max-w-none">
        <div class="aspect-[3/4] relative overflow-hidden"
             style="background: linear-gradient(160deg, #7c3aed 0%, #ec4899 55%, #1e1b4b 100%)">
          <div class="absolute inset-0 opacity-25"
               style="background: radial-gradient(circle at 75% 25%, #f4f0fe 0%, transparent 45%)"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6"
               style="background: linear-gradient(to top, rgba(8,8,16,0.95) 0%, transparent 100%)">
            <p class="font-serif text-crema-200 text-xl leading-tight">La hija de las mitangan</p>
            <p class="font-sans text-crema-400/60 text-xs mt-1">Wanafrica Ediciones · 2023</p>
          </div>
        </div>
        <div class="absolute -bottom-4 -right-4 w-full h-full bg-ocre-500/10 -z-10 hidden lg:block"></div>
      </div>
    </div>
  </section>

  <!-- ═══ 4. ACTIVISMO — índigo oscuro (igual en ambos modos) ═══ -->
  <section class="py-20 md:py-28 px-8 sm:px-12 md:px-16 bg-selva-700">
    <div class="max-w-4xl mx-auto">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-ocre-300 mb-8">Activismo</p>
      <p class="font-serif text-crema-200 leading-snug mb-10"
         style="font-size: clamp(1.6rem, 4vw, 2.8rem)">
        Durante ocho años coordinó <em class="not-italic text-ocre-300">Somos Parte del Mundo</em>
        en Guinea Ecuatorial.<br />
        <span class="text-terracota-300">Fue encarcelada en agosto de 2023.</span>
      </p>
      <p class="font-sans text-sm text-crema-200/50 mb-8 leading-relaxed max-w-xl">
        Sus seis informes de derechos humanos motivaron el escrutinio de la ONU,
        la Unión Africana y la Unión Europea.
      </p>
      <a href="/activismo"
         class="group inline-flex items-center gap-2 font-sans text-sm text-crema-200/70 hover:text-crema-200 border-b border-crema-200/20 hover:border-crema-200/60 pb-0.5 transition-colors">
        Ver informes de derechos humanos
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <!-- ═══ 5. CIFRAS ═══
       Claro: fondo blanco + cifras violeta sobre blanco
       Oscuro: fondo negro + cifras violeta sobre negro
  ══════════════════ -->
  <section class="bg-white dark:bg-obsidian-900 py-16 md:py-20 px-8 sm:px-12 md:px-16
                  border-t border-gray-100 dark:border-obsidian-700 transition-colors duration-300">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 text-center mb-12">
        {[
          { n: '8', label: 'Libros publicados' },
          { n: '8+', label: 'Conferencias internacionales' },
          { n: '6', label: 'Informes de DDHH' },
          { n: '4', label: 'Premios internacionales' },
        ].map(({ n, label }) => (
          <div>
            <p class="font-serif text-ocre-500 leading-none mb-2"
               style="font-size: clamp(3rem, 7vw, 5rem)">{n}</p>
            <p class="font-sans text-xs uppercase tracking-widest text-gray-400 dark:text-crema-400/50 transition-colors">{label}</p>
          </div>
        ))}
      </div>
      <p class="font-sans text-xs text-center text-gray-300 dark:text-crema-400/30 tracking-widest uppercase transition-colors">
        Viena &nbsp;·&nbsp; Hamburgo &nbsp;·&nbsp; Lyon &nbsp;·&nbsp; Berlín &nbsp;·&nbsp;
        Barcelona &nbsp;·&nbsp; Alcalá de Henares &nbsp;·&nbsp; Wuppertal
      </p>
    </div>
  </section>

</BaseLayout>
