---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Investigación — Trifonia Melibea Obono"
  description="Perfil académico de Trifonia Melibea Obono: becaria Humboldt, líneas de investigación, formación y docencia."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <header class="mb-14">
      <p class="font-sans text-xs tracking-widest uppercase text-ocre-500 mb-3">Perfil académico</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 dark:text-crema-200 transition-colors">
        Investigación
      </h1>
    </header>

    <div class="space-y-14">

      <!-- Afiliación actual -->
      <div class="p-6 border border-ocre-500/20 bg-ocre-500/5">
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-3">Afiliación actual</p>
        <p class="font-serif text-xl text-gray-900 dark:text-crema-200 mb-1 transition-colors">
          Becaria postdoctoral Alexander von Humboldt
        </p>
        <p class="font-sans text-sm text-gray-500 dark:text-crema-400 transition-colors">
          Universidad de Duisburg-Essen — Alemania (2024–presente)
        </p>
        <p class="font-sans text-xs text-gray-400 dark:text-crema-400/50 mt-2 transition-colors">
          La beca Alexander von Humboldt es la distinción postdoctoral más prestigiosa de Europa.
        </p>
      </div>

      <!-- Formación -->
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-6">Formación</p>
        <ol class="space-y-6">
          <li class="flex gap-5">
            <span class="font-serif text-2xl text-ocre-500 shrink-0 leading-none mt-0.5">2023</span>
            <div>
              <p class="font-sans text-sm font-medium text-gray-900 dark:text-crema-200 transition-colors">
                Doctorado en Estudios Interdisciplinares y Políticas de Igualdad
              </p>
              <p class="font-sans text-sm text-gray-500 dark:text-crema-400 transition-colors">
                Universidad de Salamanca, España
              </p>
              <p class="font-sans text-xs text-ocre-500 mt-1">Mención honorífica <em>cum laude</em></p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-serif text-2xl text-ocre-500/50 shrink-0 leading-none mt-0.5">—</span>
            <div>
              <p class="font-sans text-sm font-medium text-gray-900 dark:text-crema-200 transition-colors">
                Máster en Cooperación Internacional y Desarrollo
              </p>
              <p class="font-sans text-sm text-gray-500 dark:text-crema-400 transition-colors">
                Universidad de Murcia, España
              </p>
            </div>
          </li>
        </ol>
      </div>

      <!-- Líneas de investigación -->
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-6">Líneas de investigación</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            'Estudios poscoloniales y africanos',
            'Teoría queer y feminismos del Sur Global',
            'Literaturas africanas y latinoamericanas en español',
            'Estudios afrohispánicos',
            'Feminismos decoloniales',
            'Escritura de mujeres africanas',
            'Literatura de Guinea Ecuatorial',
            'Creación literaria',
          ].map((linea) => (
            <li class="flex items-start gap-2 font-sans text-sm text-gray-600 dark:text-crema-300 transition-colors">
              <span class="text-ocre-500 mt-0.5 shrink-0">▸</span>
              {linea}
            </li>
          ))}
        </ul>
      </div>

      <!-- Docencia -->
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-6">Docencia</p>
        <ol class="space-y-6">
          <li class="flex gap-5">
            <span class="font-sans text-xs text-gray-400 dark:text-crema-400/50 shrink-0 mt-1 w-20 text-right transition-colors">2012–2023</span>
            <div>
              <p class="font-sans text-sm font-medium text-gray-900 dark:text-crema-200 transition-colors">
                Profesora asociada de Periodismo y Ciencias Políticas
              </p>
              <p class="font-sans text-sm text-gray-500 dark:text-crema-400 transition-colors">
                Universidad Nacional de Guinea Ecuatorial
              </p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="font-sans text-xs text-gray-400 dark:text-crema-400/50 shrink-0 mt-1 w-20 text-right transition-colors">2005–2023</span>
            <div>
              <p class="font-sans text-sm font-medium text-gray-900 dark:text-crema-200 transition-colors">
                Profesora de lengua y literatura iberoamericanas
              </p>
              <p class="font-sans text-sm text-gray-500 dark:text-crema-400 transition-colors">
                Instituto Martin Luther King de Malabo
              </p>
            </div>
          </li>
        </ol>
      </div>

      <!-- Perfiles académicos -->
      <div class="pt-6 border-t border-gray-100 dark:border-obsidian-700 transition-colors">
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-4">Perfiles académicos</p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://orcid.org/0009-0009-3218-299X"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-sans text-sm text-gray-600 dark:text-crema-300 border border-gray-200 dark:border-obsidian-600 px-4 py-2 hover:border-ocre-500 hover:text-ocre-500 transition-colors"
          >
            ORCID: 0009-0009-3218-299X ↗
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
