---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const bio = await getEntry('bio', 'melibea');
const { Content } = await render(bio);
---

<BaseLayout
  title="Sobre mí — Trifonia Melibea Obono"
  description="Biografía de Trifonia Melibea Obono: escritora, académica postdoctoral Humboldt y activista de derechos humanos de Guinea Ecuatorial."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <header class="mb-14">
      <p class="font-sans text-xs tracking-widest uppercase text-ocre-500 mb-3">Quién soy</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-obsidian-900 dark:text-crema-200">
        Trifonia Melibea Obono
      </h1>
    </header>

    <!-- Frase destacada -->
    <blockquote class="border-l-4 border-ocre-500 pl-6 mb-14">
      <p class="font-serif text-xl sm:text-2xl italic text-obsidian-900 dark:text-crema-200 leading-relaxed">
        «Me defino como artivista: reivindico a través del arte el lugar de las minorías diversas en un mundo inclusivo.»
      </p>
      <footer class="font-sans text-xs text-ocre-500 mt-3 tracking-wide">— Trifonia Melibea Obono</footer>
    </blockquote>

    <!-- Contenido de la bio (Markdown renderizado) -->
    <div class="
      prose prose-lg max-w-none
      prose-headings:font-serif prose-headings:font-normal
      prose-headings:text-obsidian-900 dark:prose-headings:text-crema-200
      prose-p:font-sans prose-p:text-gray-600 dark:prose-p:text-crema-300
      prose-strong:text-obsidian-900 dark:prose-strong:text-crema-200 prose-strong:font-semibold
      prose-a:text-ocre-500 prose-a:no-underline hover:prose-a:underline
      prose-hr:border-crema-300 dark:prose-hr:border-obsidian-700
    ">
      <Content />
    </div>

    <!-- Datos académicos destacados -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 pt-10 border-t border-crema-300 dark:border-obsidian-700">
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-2">Formación</p>
        <p class="font-sans text-sm text-gray-600 dark:text-crema-300 leading-relaxed">
          Dra. en Estudios Interdisciplinares y Políticas de Igualdad<br />
          <span class="text-gray-400 dark:text-crema-400/60">Universidad de Salamanca, 2023 · <em>cum laude</em></span>
        </p>
      </div>
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-2">Beca Humboldt</p>
        <p class="font-sans text-sm text-gray-600 dark:text-crema-300 leading-relaxed">
          Becaria postdoctoral Alexander von Humboldt<br />
          <span class="text-gray-400 dark:text-crema-400/60">Universidad de Duisburg-Essen, Alemania</span>
        </p>
      </div>
      <div>
        <p class="font-sans text-xs uppercase tracking-widest text-ocre-500 mb-2">Activismo</p>
        <p class="font-sans text-sm text-gray-600 dark:text-crema-300 leading-relaxed">
          Coordinadora de Somos Parte del Mundo<br />
          <span class="text-gray-400 dark:text-crema-400/60">Guinea Ecuatorial, 2016–2023</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
